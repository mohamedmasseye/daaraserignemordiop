{
  "appId": "com.daara.app",
  "appName": "Daara App",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "api.daaraserignemordiop.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "1060878832216-l4nfks09797bsh49u8jqce0kd95tfb8e.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  },
  "ios": {
    "useSwiftPackageManager": false,
    "infoPlist": {
      "UIBackgroundModes": ["remote-notification"],
      "CFBundleURLTypes": [
        {
          "CFBundleTypeRole": "Editor",
          "CFBundleURLSchemes": [
            "com.googleusercontent.apps.1060878832216-kkdinu78sa2qu2p903037ln4httod4om"
          ]
        }
      ]
    }
  }
}
